# Copy to .env.local. scripts/emberkv-setup.sh fills in the EmberKV tokens.
DATABASE_URL=postgres://kiln:kiln@127.0.0.1:5433/kiln
EMBERKV_URL=http://127.0.0.1:8080
# read_write key scoped to: sessions, limits, idempotency, locks, cache
EMBERKV_TOKEN=
# Optional admin key: engine statistics on the System page, and E2E test resets
EMBERKV_ADMIN_TOKEN=
# Show one-click demo accounts on the login page. Never on real data.
DEMO_MODE=true
TIME_ZONE=Asia/Jakarta
